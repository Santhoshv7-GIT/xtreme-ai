{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/search",
      "destination": "/api/search"
    },
    {
      "source": "/api/fetch-page",
      "destination": "/api/fetch-page"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
